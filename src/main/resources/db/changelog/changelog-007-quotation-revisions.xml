<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="7" author="neosow">
        <addColumn tableName="quotations">
            <column name="parent_quotation_id" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="quotations"
                                 baseColumnNames="parent_quotation_id"
                                 constraintName="fk_quotation_parent"
                                 referencedTableName="quotations"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
