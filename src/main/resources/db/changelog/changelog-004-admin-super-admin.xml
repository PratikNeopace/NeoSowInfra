<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="6" author="neosow">
        <!-- Add hierarchical columns to users -->
        <addColumn tableName="users">
            <column name="parent_admin_id" type="UUID"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint baseTableName="users" baseColumnNames="parent_admin_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_users_parent_admin" onDelete="SET NULL"/>

        <!-- Approvals Table -->
        <createTable tableName="approvals">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="submitted_by" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="reviewed_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="approvals" baseColumnNames="submitted_by"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_approvals_submitter" onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="approvals" baseColumnNames="reviewed_by"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_approvals_reviewer" onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
