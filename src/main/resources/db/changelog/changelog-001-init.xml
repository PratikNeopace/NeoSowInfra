<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="1" author="neosow">
        <!-- Users table -->
        <createTable tableName="users">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(100)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
        </createTable>

        <!-- Roles table -->
        <createTable tableName="roles">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints unique="true" nullable="false"/>
            </column>
        </createTable>

        <!-- User Roles mapping table -->
        <createTable tableName="user_roles">
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="user_roles" columnNames="user_id, role_id" constraintName="pk_user_roles"/>

        <addForeignKeyConstraint baseTableName="user_roles" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_user_roles_user" onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="user_roles" baseColumnNames="role_id"
                                 referencedTableName="roles" referencedColumnNames="id"
                                 constraintName="fk_user_roles_role" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="2" author="neosow">
        <!-- Seed initial roles -->
        <!-- Note: We generate UUIDs manually for initial inserts to ensure consistency or use SQL functions.
             Standard UUID values:
             ROLE_USER: '2867ef5e-b8d9-48cb-8a07-88f5a6cc05ea'
             ROLE_ADMIN: '7c40f5a7-75e1-455b-bce9-ee8ee8590623'
             ROLE_SUPER_ADMIN: '0686940a-5c1a-4648-8df0-639ba399580b'
        -->
        <insert tableName="roles">
            <column name="id" value="2867ef5e-b8d9-48cb-8a07-88f5a6cc05ea"/>
            <column name="name" value="ROLE_USER"/>
        </insert>
        <insert tableName="roles">
            <column name="id" value="7c40f5a7-75e1-455b-bce9-ee8ee8590623"/>
            <column name="name" value="ROLE_ADMIN"/>
        </insert>
        <insert tableName="roles">
            <column name="id" value="0686940a-5c1a-4648-8df0-639ba399580b"/>
            <column name="name" value="ROLE_SUPER_ADMIN"/>
        </insert>
    </changeSet>

    <changeSet id="3" author="neosow">
        <!-- Customers table -->
        <createTable tableName="customers">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="TEXT"/>
            <column name="birth_date" type="DATE"/>
            <column name="anniversary_date" type="DATE"/>
            <column name="drawing_plan_url" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
        </createTable>

        <!-- Family Members table -->
        <createTable tableName="family_members">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(50)"/>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="contact" type="VARCHAR(20)"/>
            <column name="email" type="VARCHAR(100)"/>
            <column name="birthdate" type="DATE"/>
            <column name="design_approval" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="finance_approval" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="family_members" baseColumnNames="customer_id"
                                 referencedTableName="customers" referencedColumnNames="id"
                                 constraintName="fk_family_members_customer" onDelete="CASCADE"/>

        <!-- Projects table -->
        <createTable tableName="projects">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="UUID">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="work_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="carpet_area" type="DECIMAL(10,2)"/>
            <column name="area_unit" type="VARCHAR(10)"/>
            <column name="built_up_area" type="DECIMAL(10,2)"/>
            <column name="budget" type="DECIMAL(15,2)"/>
            <column name="timeline" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="projects" baseColumnNames="customer_id"
                                 referencedTableName="customers" referencedColumnNames="id"
                                 constraintName="fk_projects_customer" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="4" author="neosow">
        <!-- Quotations table -->
        <createTable tableName="quotations">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="project_unit" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="subtotal" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="discount" type="DECIMAL(15,2)" defaultValueNumeric="0.0">
                <constraints nullable="false"/>
            </column>
            <column name="include_gst" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="gst_amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="quotations" baseColumnNames="customer_id"
                                 referencedTableName="customers" referencedColumnNames="id"
                                 constraintName="fk_quotations_customer" onDelete="CASCADE"/>

        <!-- Quotation Items table -->
        <createTable tableName="quotation_items">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="quotation_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="subcategory" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="width" type="VARCHAR(50)"/>
            <column name="height" type="VARCHAR(50)"/>
            <column name="depth" type="VARCHAR(50)"/>
            <column name="unit" type="VARCHAR(20)"/>
            <column name="qty" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="unit_rate" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="quotation_items" baseColumnNames="quotation_id"
                                 referencedTableName="quotations" referencedColumnNames="id"
                                 constraintName="fk_quotation_items_quotation" onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
